# OpenAI-compatible LLM configuration.
# For Groq, use OPENAI_BASE_URL=https://api.groq.com/openai/v1,
# OPENAI_API_KEY=<your-groq-key>, and a Groq-supported model such as
# llama-3.3-70b-versatile.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Search provider configuration: tavily, serper, or mock
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_PROVIDER=tavily
MOCK_MODE=false
TOP_K=6
SYNTHESIS_CONTEXT_TOKENS=3000
RUNS_DIR=data/runs
