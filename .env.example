# OpenAI-compatible LLM configuration.
# For Groq, use OPENAI_BASE_URL=https://api.groq.com/openai/v1,
# OPENAI_API_KEY=<your-groq-key>, and a Groq-supported model such as
# llama-3.3-70b-versatile.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Search provider configuration: tavily, serper, or mock
TAVILY_API_KEY=
SERPER_API_KEY=
SEARCH_PROVIDER=tavily
MOCK_MODE=false
TOP_K=6
SYNTHESIS_CONTEXT_TOKENS=3000
MAX_SEARCH_CALLS=8
SEARCH_RETRY_BACKOFF_SECONDS=0.25
PLANNING_BUDGET_SECONDS=8
SEARCH_BUDGET_SECONDS=5
EXTRACTION_BUDGET_SECONDS=25
SYNTHESIS_BUDGET_SECONDS=45
TOTAL_BUDGET_SECONDS=85
RUNS_DIR=data/runs
