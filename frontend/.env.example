# Base URL of the report API. Leave unset for local development (the Vite dev server proxies
# /api to http://127.0.0.1:8000). For the Vercel deployment, set this in the project's
# environment variables to the Render backend URL, e.g.:
# VITE_API_BASE=https://omnirush-backend.onrender.com
VITE_API_BASE=
