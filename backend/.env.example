# Offline defaults. Set MOCK_MODE=true and SEARCH_PROVIDER=mock for reproducible runs.
MOCK_MODE=false
SEARCH_PROVIDER=tavily
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
TAVILY_API_KEY=
SERPER_API_KEY=
SCRAPLING_FALLBACK=true
SCRAPLING_TIMEOUT_SECONDS=15
TOP_K=6
SYNTHESIS_CONTEXT_TOKENS=3000
MAX_SEARCH_CALLS=8
SEARCH_RETRY_BACKOFF_SECONDS=0.25
PLANNING_BUDGET_SECONDS=8
SEARCH_BUDGET_SECONDS=5
EXTRACTION_BUDGET_SECONDS=25
SYNTHESIS_BUDGET_SECONDS=45
TOTAL_BUDGET_SECONDS=85
RUNS_DIR=data/runs

# Recurring-report scheduler (one uvicorn worker assumed; in-memory event bus).
SCHEDULER_TICK_SECONDS=30

# Completion notifications. Optional webhook ping and SMTP email sink.
COMPLETION_WEBHOOK_URL=
NOTIFICATION_EMAIL_TO=
NOTIFICATION_EMAIL_FROM=research-agent@localhost
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
